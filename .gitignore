# build outputs (regenerated by sh rust/build.sh, sh formal/check.sh, sh core/check/run.sh)
rust/target/
formal/.olean/
core/check/out/
.DS_Store

# papers (copyrighted full texts; keep local)
papers/pdf/
papers/text/
discussion/.codex-turns/
discussion/.deepseek-turns/
discussion/.fable-turns/

# secrets (API keys etc.; never commit)
.env
.env.*
!.env.example

# S45 TRM training data (regenerated by experiments/trm_data.jl, ~43 MB)
experiments/trm-data/

# S56: reference fixtures of the official TRM (regenerable, same sha: experiments/trm/oracle_export.py; sums in fixtures/SHA256SUMS)
experiments/trm/fixtures/*.json
experiments/trm/__pycache__/
experiments/trm/fixtures_r5/*.json

# S54 trial inputs, references and wrapped run files (regenerated by experiments/trial/make_trial.jl and ref_gate.sh; sha in experiments/freeze-trial-run-inputs.txt)
experiments/trial-data/

# S57: per-step records of the evaluation (83 MB, regenerable: experiments/draw_conf_grid.jl with draw-conf-bits/)
experiments/draw-conf-out/
# scratch of a stopped DeepSeek loop (kept on disk, not tracked)
.lab-scratch/
# S56 diagnostics: output dumps (regenerable: experiments/trm/diag_precision.py) and the stopped DeepSeek seat's probe scratch (kept on disk, not tracked)
experiments/trm/diag/*.json
experiments/trm/diag/probe/
# S60: build output of the separate workspace
rust/trm-det/target/
